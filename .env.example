# ==============================================================================
# VenueFlow Exhibition Platform - Environment Variables Template
# ==============================================================================
# Instructions: Copy this file to .env and provide your local configuration.
# NEVER commit the .env file or real secrets to version control.
# ==============================================================================

# Node runtime environment (development, test, production)
NODE_ENV=development

# Application base URL for links and CORS origins
APP_URL=http://localhost:5173

# MongoDB connection string
# Format: mongodb://localhost:27017 or mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB database name
MONGODB_DB=venueflow_dev

# JWT access token secret key
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_HERE

# JWT refresh token secret key
# Generate via: openssl rand -base64 48
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE

# Initial seed admin username
SEED_ADMIN_USERNAME=admin

# Initial seed admin password
# Generate via: openssl rand -base64 16
SEED_ADMIN_PASSWORD=YOUR_SEED_ADMIN_PASSWORD_HERE

# PayFast Merchant ID for payment gateway
PAYFAST_MERCHANT_ID_business_expo=YOUR_PAYFAST_MERCHANT_ID_HERE

# PayFast Merchant Key
# Generate or retrieve from PayFast dashboard
PAYFAST_MERCHANT_KEY_business_expo=YOUR_PAYFAST_MERCHANT_KEY_HERE

# PayFast Passphrase
# Generate or retrieve from PayFast dashboard
PAYFAST_PASSPHRASE_business_expo=YOUR_PAYFAST_PASSPHRASE_HERE

# PayFast Sandbox URL for testing
PAYFAST_SANDBOX_URL=https://sandbox.payfast.co.za/eng/process

# SafePay Public Key for payment gateway
SAFEPAY_PUBLIC_KEY_business_expo=YOUR_SAFEPAY_PUBLIC_KEY_HERE

# SafePay Secret Key
# Generate or retrieve from SafePay dashboard
SAFEPAY_SECRET_KEY_business_expo=YOUR_SAFEPAY_SECRET_KEY_HERE

# SafePay Sandbox URL
SAFEPAY_SANDBOX_URL=https://sandbox.api.getsafepay.com

# Webhook signing secret for simulated payment callbacks
# Generate via: openssl rand -hex 32
SIMULATED_WEBHOOK_SECRET=YOUR_SIMULATED_WEBHOOK_SECRET_HERE

# S3 / Object storage endpoint for uploaded payment receipts
OBJECT_STORAGE_URL=http://localhost:9000/venueflow-receipts